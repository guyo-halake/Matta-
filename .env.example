# Astra AI Personal Assistant & System Control Configuration

# 1. TELEGRAM BOT & SECURITY (REQUIRED)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
ALLOWED_TELEGRAM_USER_ID=your_numeric_telegram_user_id

# 2. GEMINI AI ENGINE (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 3. REAL GITHUB & VERCEL CONNECTIONS
GH_TOKEN=your_github_personal_access_token
VERCEL_TOKEN=your_vercel_account_token

# 4. REAL CALENDAR CONNECTION (Apple iCal Webcal URL or Google OAuth)
APPLE_ICAL_URL=https://pXX-caldav.icloud.com/published/2/XXXXXXXX
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# 5. PERSONALIZATION & VOICE
BOT_NAME=Astra
OWNER_NAME=Razak
DEFAULT_VOICE_MODE=true
PROACTIVE_CRON_SCHEDULE=0 6 * * *
